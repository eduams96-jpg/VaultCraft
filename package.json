{
  "name": "vaultcraft",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint src scripts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:template": "node scripts/build-template-db.mjs",
    "package:win": "node scripts/package-win.mjs",
    "check": "npm run lint && tsc --noEmit && npm run build",
    "package:installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File packaging/windows/build-installer.ps1"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "VaultCraft Studio: organizador local de coleção e backlog de jogos (Windows)."
}
